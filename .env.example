# Digital Point LLC — environment scaffolding.
# Copy to .env.local and fill in real values. Never commit .env.local.

# SMTP (Resend or Nodemailer transport)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Founder routing — audit, contact, newsletter, recovery submissions CC both.
# Backend-only. Never display these on the site.
FOUNDER_EMAIL_FAIZAN=faizan@digitalpointllc.com
FOUNDER_EMAIL_ANWAAR=anwaar@digitalpointllc.com

# Database
DATABASE_URL=

# Upstash Redis (rate limit + cache)
UPSTASH_REDIS_KV_REST_API_URL=
UPSTASH_REDIS_KV_REST_API_TOKEN=

# Groq (Cosmo chat)
GROQ_API_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://digitalpointllc.com
