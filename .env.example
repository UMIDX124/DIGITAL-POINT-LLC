# Digital Point LLC — environment scaffolding.
# Copy to .env.local and fill in real values. Never commit .env.local.

# SMTP (Resend or Nodemailer transport)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Founder routing — audit, contact, newsletter, recovery submissions CC both.
# Backend-only. Never display these on the site.
FOUNDER_EMAIL_FAIZAN=faizan@digitalpointllc.com
FOUNDER_EMAIL_ANWAAR=anwaar@digitalpointllc.com

# Database — PostgreSQL (Neon recommended via Vercel Marketplace).
# Pooled URL for runtime, direct URL only if you need migrations from app code.
# Example: postgresql://user:pass@ep-xxx-pooler.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Admin bearer token for /api/submissions + /api/health/* endpoints
ADMIN_KEY=

# Google Search Console verification meta tag (optional)
GOOGLE_SITE_VERIFICATION=

# Sentry — error monitoring (optional). Sign up at sentry.io, create a
# Next.js project, copy the DSN. NEXT_PUBLIC_ prefix is required so the
# client SDK can read it. SENTRY_AUTH_TOKEN / ORG / PROJECT enable
# source-map upload + release tracking during Vercel builds.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Upstash Redis (rate limit + cache)
UPSTASH_REDIS_KV_REST_API_URL=
UPSTASH_REDIS_KV_REST_API_TOKEN=

# Groq (Cosmo chat)
GROQ_API_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://digitalpointllc.com
